# ==========================================
# Directory Leads - Environment Variables
# ==========================================

# 1. DATABASE
# ------------------------------------------
# Default: bundled zero-install PGlite (run `npm run db:dev`)
DATABASE_URL=postgres://127.0.0.1:5434/pglite
# One connection is the safe default: the queries still go out pipelined on it, and nothing
# here needs a pool. Keep it as-is on managed Postgres.
POOL_MAX=1
# Bundled dev database only. PGlite serves every connection from one Postgres session, whose
# unnamed prepared statement is shared, so the web app and the worker running at the same time
# can answer each other's queries ("bind message supplies 8 parameters, but prepared statement
# "" requires 6"). Named statements are private to each connection. Leave this unset (or
# remove it) when DATABASE_URL points at Neon: behind a pooler, a statement prepared on one
# backend is missing from the next.
DB_NAMED_STATEMENTS=true

# Production Postgres (Neon free tier) - the worker on your PC connects over SSL:
# DATABASE_URL=postgres://user:password@ep-sample-pooler.neon.tech/directory_leads?sslmode=require

# 2. WEB APP (Next.js 14)
# ------------------------------------------
SESSION_SECRET=dev-secret-replace-with-long-random-string-in-production
ADMIN_EMAIL=team@example.com
ADMIN_PASSWORD=devpassword

# 3. WORKER
# ------------------------------------------
POLL_INTERVAL_MS=5000
PORT=8080
# The dashboard shows "worker online" while a heartbeat row is fresher than this.
# The worker touches it on every poll and again inside a running job, so the default
# only has to survive one slow request plus a database round trip.
WORKER_HEARTBEAT_STALE_MS=120000

# Listings one query may bring back, per keyword x location x source. The New run form
# starts here and you can change it per run; it is the ask, not a promise of new leads.
MAX_RESULTS=100
# How many NEW leads a source should add before the run stops itself (default 100, set on
# the form per run, stored in `jobs.lead_target` — there is no environment variable for
# it). Listings the ledger already knows are merged or skipped and do not count toward it,
# so 100 wanted really means 100 businesses you have not collected before. A paid source
# is only ever asked for what is still missing, so this number also bounds the invoice.

# Overpass + Nominatim are courtesy-capped (about one request per second).
# Queries are sequential with this spacing between them.
OSM_DELAY_MIN_MS=4000
OSM_DELAY_MAX_MS=8000
# A throttled request waits OSM_RETRY_BACKOFF_MS; a request that merely timed out
# waits OSM_TRANSIENT_RETRY_MS (the public Overpass instance answers 504 while busy
# and serves the same query seconds later). After OSM_MAX_RETRIES attempts the
# source is marked `blocked`, the job still finishes `done`, and the source can be
# re-run later.
OSM_RETRY_BACKOFF_MS=30000
OSM_TRANSIENT_RETRY_MS=20000
OSM_MAX_RETRIES=2
# Public endpoints; a self-hosted or paid instance can be swapped in here.
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org/search
# Cached geocoded areas and their bounding boxes (ms). Areas rarely move.
OSM_GEOCACHE_TTL_MS=604800000

# Both services inspect the User-Agent. Their gateways refuse a placeholder
# domain such as "@example.com" (Nominatim answers 403, Overpass 406), so put a
# real address or site here: Nominatim's usage policy asks for identifiable contact.
OSM_USER_AGENT="DirectoryLeads/0.1 (own-business lead tool; contact: you@yourdomain.com)"

# Website enrichment: each domain is crawled at most once (website_observations).
ENRICH_ENABLED=true
ENRICH_DELAY_MIN_MS=1500
ENRICH_DELAY_MAX_MS=3500
ENRICH_TIMEOUT_MS=12000
ENRICH_MAX_PAGE_BYTES=400000
ENRICH_MAX_PAGES_PER_HOST=3
# Domains one job will visit. A crawl is polite but slow, so this is the knob that
# bounds how long a job takes; leads it did not reach stay enriched=false.
ENRICH_MAX_HOSTS=80
# How long a cached observation is trusted before the site is looked at again.
ENRICH_CACHE_DAYS=180
ENRICH_USER_AGENT="DirectoryLeads/0.1 (own-business lead tool)"

# 5. PAID DIRECTORY SOURCES (Apify)
# ------------------------------------------
# `yelp` and `hotfrog` run third-party Apify Actors: a licensed collector does the
# scraping, this app pays per result, and no login wall of ours is ever touched.
# Leave the token empty and both sources stop as `blocked` before any request goes out,
# so the free sources keep working without an Apify account.
# Get a token at https://console.apify.com/account/integrations — never commit it.
APIFY_API_TOKEN=
# Results the paid sources may return per calendar month, across every job. Apify's free
# plan carries about $5 of credit, which is roughly 1,800 rows at these prices; 1,500
# leaves room for the flat start charge HotFrog adds. The worker stops asking for more
# once this is used up, and a re-run bills again, so past results count, not just kept ones.
APIFY_MONTHLY_RESULT_CAP=1500
# Actor slugs. Changing these swaps the collector, not this app.
APIFY_YELP_ACTOR=memo23/yelp-scraper
APIFY_HOTFROG_ACTOR=solidcode/hotfrog-scraper
# HotFrog's scraper narrows a search by country and takes the ISO code, not the name: `us`,
# `gb`, `in`, `au`, `ca`, `ie`, `nz`, `de`, `fr`, `es`, `it`, `nl`, `at`, `ch`, `dk`, `no`,
# `pl`, `pt`, `sg`, `my`, `za`, `br`, `mx`, `ar`, `jp`, `hk`, `ph`. A full name typed here is
# translated when it is one of the common ones; anything unrecognised stops the source before
# a request goes out, rather than quietly searching a different country. Yelp does not use
# this — its location string already says where.
APIFY_COUNTRY=us
# How long one Actor run may take before the worker gives up on it (seconds). Apify
# enforces this on its side too, and slow Actors are better raised here than retried.
APIFY_RUN_TIMEOUT_S=300
# A run is started over HTTP, which Apify holds open for at most 60 seconds. Past that the
# worker asks "is it done yet" this often, up to APIFY_RUN_TIMEOUT_S worth of questions.
# Each one costs a request from JOB_MAX_REQUESTS, so keep it comfortably above a few seconds.
APIFY_POLL_INTERVAL_MS=5000
# API endpoint; only change it for a proxy or a regional Apify cloud.
APIFY_BASE_URL=https://api.apify.com/v2

# Which driver backs each source is fixed in the worker (`adapterFor`): overpass for
# `osm`, inline rows for `csv`, the Apify Actors above for `yelp` and `hotfrog`. A
# differently-licensed collector for the same directory replaces the driver there —
# no migration and no UI change.
